{
  "platform": "pinpointhq",
  "description": "Reusable field mapping for Pinpoint job applications",
  "fields": {
    "First Name": "identity.first_name",
    "Last Name": "identity.last_name",
    "Email Address": "identity.email",
    "Phone Number": "identity.phone",
    "Street Address": "identity.address.street",
    "City": "identity.address.city",
    "State": "identity.address.state",
    "Zipcode": "identity.address.postal_code",
    "Resume": "documents.resume_path",
    "What is your desired type of employment?": "preferences.employment_type",
    "What is your preferred shift?": "preferences.preferred_shift",
    "Available Date": "preferences.earliest_start_date",
    "Have you previously been employed by Group O?": "application_answers.previous_employment",
